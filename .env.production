# Public build settings for `npm run build` / `npm run pack` (Vite production mode).
# NOT secrets: these are the URLs of Nudge's own server functions (api/stt token minter, api/predict
# Gemini proxy), which hold the real API keys server-side.
# Never put API keys in any VITE_* variable; they are bundled into the client.
VITE_STT_TOKEN_URL=https://nudge-seven-psi.vercel.app/api/stt/token
VITE_PREDICT_URL=https://nudge-seven-psi.vercel.app/api/predict
