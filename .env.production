# Public build settings for `npm run build` / `npm run pack` (Vite production mode).
# NOT secrets: these are the URLs of Nudge's own server functions (api/stt token minter, api/predict
# Gemini proxy), which hold the real API keys server-side.
# Never put API keys in any VITE_* variable; they are bundled into the client.
VITE_STT_TOKEN_URL=https://nudge-seven-psi.vercel.app/api/stt/token
VITE_PREDICT_URL=https://nudge-seven-psi.vercel.app/api/predict
# Gate defaults for packaged builds. D17 (G2): rolling STT uses batch, because the Even app appears to
# block wss:// to Scribe realtime. Step 2 has been on since G2. Override at pack time if needed.
VITE_ROLLING_STT=batch
VITE_STEP2=1
# D21 (G3b passed, #134): Conversation ships. The launcher shows Practice + Conversation (tap help is inside it).
VITE_STEP3=1
# D26 (0.4.9 check, #148): head tilt ships (look down/up = next/previous, sideways = reveal more). Speaker gate stays off (untested).
VITE_IMU=1
